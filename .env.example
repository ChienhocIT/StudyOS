# Local-only examples. scripts/setup.ps1 creates fresh random secrets in ignored .env.
POSTGRES_DB=studyos
POSTGRES_USER=studyos
POSTGRES_PASSWORD=local-studyos-postgres-change-me
RABBITMQ_USER=studyos
RABBITMQ_PASSWORD=local-studyos-rabbit-change-me
MINIO_ROOT_USER=studyos
MINIO_ROOT_PASSWORD=local-studyos-minio-change-me
JWT_SIGNING_KEY=local-development-signing-key-at-least-32-characters
INTERNAL_JWT_SECRET=local-development-internal-key-at-least-32-characters
S3_BUCKET=studyos-sources
MODEL_PROVIDER=local-extractive
MODEL_PROVIDER_API_KEY=
MODEL_PROVIDER_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
